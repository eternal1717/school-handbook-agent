# ============================================================
# 知津 · 校园规章智能问答 —— 环境配置样例
#
# 用法：复制成 .env 后按需修改。所有项都有合理默认值，
# 最小配置只需要填 DEEPSEEK_API_KEY（不填则走演示模式）。
#
# 完整说明见 README.md；每一项的取舍理由都写在 app/config.py 的注释里。
# ============================================================

# ===== 大模型（DeepSeek）=====
DEEPSEEK_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-flash
# auto: 有 Key 走真实 API，没有则自动降级为演示模式；也可强制 api / mock
LLM_MODE=auto
LLM_TEMPERATURE=0.3

# 思维链（reasoning_content）开关：auto / on / off
#   auto = 内部调用（分类/改写/重排/自省）走 off 快通道，最终回答走 on 并把思考过程展示出来
# 实测（2026-09 探针，同一问题）：
#   不传该参数   → 11.0s，1426 tok，其中思维链 943 tok
#   thinking 关闭 →  2.7s， 394 tok，无思维链      ← 快 4 倍、省 3.6 倍
#   thinking 开启 →  6.2s， 891 tok，思维链 526 tok
LLM_THINKING=auto

# deepseek-flash 是推理模型，**思维链和正文共享 max_tokens 额度**。
# 给太小（实测 1500）会出现「思维链吃光额度、正文 0 个字」——用户看到一条空回答。
LLM_MAX_TOKENS=4096
# 内部调用的输出额度。这些调用已关掉 thinking，只输出几百 token 的 JSON。
LLM_INTERNAL_MAX_TOKENS=900
LLM_TIMEOUT=60

# 是否跟随系统代理（HTTP_PROXY/HTTPS_PROXY）。默认 false = 忽略代理，
# 避免从带残留代理变量的终端/IDE 启动时报极难排查的 "Connection error."。
LLM_USE_ENV_PROXY=false
# 流式重试次数（只在还没输出任何内容时才重试，避免用户看到重复的半截回答）
LLM_RETRIES=2
# 业务级重试：用于分类/改写/重排这类非流式的一次性调用
LLM_TASK_RETRIES=3

# ===== 数据库 =====
# SQLite 没有账号密码，只有文件路径。
# 将来换 MySQL 只需改这一行（并安装 aiomysql），代码不用动：
# DATABASE_URL=mysql+aiomysql://root:你的密码@localhost:3306/school_agent
DATABASE_URL=sqlite+aiosqlite:///./data/school.db

# ===== Embedding（本地模型，禁止联网下载）=====
EMBEDDING_MODEL_PATH=R:\models\bge-small-zh-v1.5
EMBEDDING_DIM=512
# BGE 中文模型官方建议：查询侧加指令前缀，文档侧不加
QUERY_INSTRUCTION=为这个句子生成表示以用于检索相关文章：

# ===== 向量库 =====
CHROMA_DIR=./data/chroma
CHROMA_COLLECTION=school_handbook
# BM25 索引落盘位置。它只是 ChromaDB 的派生缓存——删掉会自动重建，
# 所以不必备份，也不该提交到 Git。
BM25_INDEX_PATH=./data/bm25_index.json

# ===== 文本切分 =====
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# ===== 检索 =====
TOP_K=4
# 旧版「相似度低于阈值就拒答」用的阈值。改造后不再用它一刀切拒答，
# 改为触发自省判定（详见 README「拒答」一节）。
SIMILARITY_THRESHOLD=0.35

# ===== 混合检索（向量 + BM25）=====
# 单一向量检索对「第七十七条」「学号」这类精确标识符召回很弱，加一路 BM25 互补。
# 消融实测：Recall@5 从 80.0%（纯向量）提到 93.3%（混合）。
HYBRID_ENABLED=true
VECTOR_CANDIDATES=30
BM25_CANDIDATES=30
# RRF（Reciprocal Rank Fusion）平滑常数，行业惯例取 60。
# RRF 只用「排名」不用「分数」，所以不必把余弦相似度和 BM25 分数归一化到同一量纲。
RRF_K=60
# 两路融合后，进入重排的候选数
FUSED_CANDIDATES=20
# 重排后最终留给大模型的资料条数
RERANK_TOP_N=5
BM25_K1=1.5
BM25_B=0.75

# ===== 重排 =====
# 零依赖方案：用大模型做 listwise 重排（把候选编号丢给模型，让它输出排序）。
# 备选是本地交叉编码器 BGE-reranker，精度更高但要下 1GB 模型，故默认不开。
RERANK_ENABLED=true
RERANK_CHARS=180

# ===== Agent（自省循环 + 工具调用）=====
AGENT_ENABLED=true
# 自省循环最多再重查几次。必须设硬上限，否则遇到答不了的问题会无限改写重查、烧钱烧时间。
# 上限内仍不充分就明确拒答——「拒答」是特性，不是缺陷。
AGENT_MAX_HOPS=2
# 复杂度路由：简单问题走单跳（快、便宜），复杂问题才进 Agent 循环。
COMPLEXITY_ROUTING=true
QUERY_REWRITE_ENABLED=true
INTENT_ROUTING=true

# ===== 安全 =====
# 检索到的文档一律视为「证据」而非「指令」。
# 手册里若出现「忽略以上指令」这类文本，不做防护时模型会照做。
GUARD_ENABLED=true

# ===== 可观测 =====
TRACE_ENABLED=true

# ===== 增量去重（上传新文档时，只补知识库里没有的内容）=====
# 默认只开精确去重。实测（tests/calibrate_dedup.py）：
#   完全相同              → 1.0000
#   长段落只改一个字        → 0.9993  ← 改版手册的新内容会被误判成重复
#   同义改写              → 0.9674
# 也就是说语义去重「能抓的正好是危险的，想抓的又抓不到」，所以默认关闭。
DEDUP_EXACT=true
DEDUP_SEMANTIC=false
DEDUP_SIMILARITY=0.97

# ===== 记忆 =====
SHORT_TERM_ROUNDS=10
SUMMARY_EVERY_ROUNDS=6

# ===== 服务 =====
HOST=127.0.0.1
PORT=8000
