    {
      "id": "ex-01",
      "category": "exact_id",
      "question": "关于缓考的第二十条是怎么规定的？",
      "expect": {
        "needs_retrieval": true,
        "answerable": true,
        "gold_keyword_sets": [["第二十条", "缓考", "书面申请"], ["第二十条", "缓考", "教务部"]],
        "answer_groups": [["书面申请", "提出申请", "考前"], ["教务部", "审批"], ["证明", "医院"]],
        "must_not_contain": []
