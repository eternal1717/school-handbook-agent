        "needs_retrieval": true,
        "answerable": true,
        "gold_keyword_sets": [],
        "answer_groups": [["多个", "几个", "不同", "哪一份", "哪一章", "哪一部", "具体指", "章节", "两份以上", "若指"]],
        "must_not_contain": []
